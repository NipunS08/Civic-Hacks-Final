{
  "name": "civiclens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "doctor": "ts-node --project tsconfig.json scripts/doctor.ts",
    "check-links": "ts-node --project tsconfig.json scripts/check-links.ts",
    "ingest": "ts-node --project tsconfig.json scripts/ingest.ts",
    "test": "node --test tests/*.test.mjs",
    "mobile": "npm run start --workspace @civiclens/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @civiclens/mobile",
    "mobile:export": "npm run export:web --workspace @civiclens/mobile"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "lucide-react": "1.62.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/mobile",
    "packages/shared"
  ]
}
